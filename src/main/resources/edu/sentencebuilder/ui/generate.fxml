<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.GenerateController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8">
        <Label text="Starting word:"/>
        <TextField fx:id="startWordField" promptText="e.g. the"/>
        <Label text="Algorithm:"/>
        <ComboBox fx:id="algorithmBox"/>
        <Button fx:id="generateButton" text="Generate" onAction="#onGenerate"/>
    </HBox>
    <Label fx:id="resultLabel" wrapText="true" text="(generated sentence appears here)"/>
</VBox>
