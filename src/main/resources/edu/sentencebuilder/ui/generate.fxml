<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.GenerateController" styleClass="page" spacing="20">
    <VBox spacing="5">
        <Label text="Generate" styleClass="page-title"/>
        <Label text="Create a sentence from a starting word using a selected algorithm." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
    </VBox>
    <HBox spacing="20" VBox.vgrow="ALWAYS" alignment="TOP_LEFT">
        <VBox styleClass="panel,settings-panel" spacing="10" minWidth="270" prefWidth="310" maxWidth="310">
            <Label text="Starting word" styleClass="field-label" labelFor="$startWordField"/>
            <TextField fx:id="startWordField" promptText="e.g. the" onAction="#onGenerate"/>
            <Label text="Algorithm" styleClass="field-label" labelFor="$algorithmBox"/>
            <ComboBox fx:id="algorithmBox" maxWidth="Infinity"/>
            <Label text="Max words" styleClass="field-label" labelFor="$maxWordsSpinner"/>
            <Spinner fx:id="maxWordsSpinner" editable="true" maxWidth="Infinity"/>
            <Button fx:id="generateButton" text="Generate" onAction="#onGenerate" styleClass="primary" maxWidth="Infinity"/>
        </VBox>
        <VBox styleClass="panel" spacing="24" HBox.hgrow="ALWAYS" minWidth="0">
            <Label text="Generated sentence" styleClass="section-title"/>
            <Label fx:id="resultLabel" text="Your sentence will appear here." wrapText="true" minHeight="-Infinity" maxWidth="Infinity" styleClass="sentence-result"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label text="Successful generations are saved to Sentence History." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </HBox>
</VBox>
