<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.BatchGenerateController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8">
        <Label text="Number of sentences:"/>
        <Spinner fx:id="countSpinner" editable="true" min="1" max="1000" initialValue="10"/>
        <Label text="Algorithm:"/>

        <ComboBox fx:id="algorithmBox"/>

        <Button
            fx:id="generateButton"
            text="Generate"
            onAction="#onGenerate"
        />
    </HBox>
    <!-- Let the results shrink so the progress and timing controls keep their space. -->
    <ListView fx:id="sentenceList" minHeight="0" VBox.vgrow="ALWAYS"/>
    <!-- Only selected rows that have not already been imported are eligible. -->
    <Button
        fx:id="addToCorpusButton"
        text="Add selected to corpus"
        disable="true"
        onAction="#onAddToCorpus"
    />

    <!-- Aalvee -->
    <!-- The controller binds this to the running batch task. -->
    <ProgressBar
        fx:id="progressBar"
        progress="0.0"
        minHeight="24"
        prefHeight="24"
        maxHeight="24"
        maxWidth="Infinity"
    />

    <!-- The elapsed counter resets for each batch and keeps its final duration. -->
    <Label fx:id="elapsedLabel" text="Elapsed: 0:00.0"/>

    <Label
        fx:id="statusLabel"
        text="Generate a batch, then select sentences to add."
        wrapText="true"
    />
</VBox>
