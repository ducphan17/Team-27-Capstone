<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.BatchGenerateController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8">
        <Label text="Number of sentences:"/>
        <Spinner fx:id="countSpinner" editable="true" min="1" max="1000" initialValue="10"/>
        <Label text="Algorithm:"/>
        <ComboBox fx:id="algorithmBox"/>
        <Button text="Generate" onAction="#onGenerate"/>
    </HBox>
    <ListView fx:id="sentenceList" VBox.vgrow="ALWAYS"/>
    <Button fx:id="addToCorpusButton" text="Add to corpus" disable="true" onAction="#onAddToCorpus"/>
</VBox>
