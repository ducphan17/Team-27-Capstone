<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.AutocompleteController" styleClass="page" spacing="20">
    <VBox spacing="5"><Label text="Autocomplete" styleClass="page-title"/>
        <Label text="Write a sentence and choose suggested words as you go." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox>
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="panel" spacing="16" HBox.hgrow="ALWAYS" minWidth="300">
            <Label text="Your sentence" styleClass="section-title" labelFor="$inputField"/>
            <TextField fx:id="inputField" promptText="Start typing…"/>
            <Label text="Click a suggestion to add it. End with . ! or ? to save, or press Enter." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Label fx:id="statusLabel" wrapText="true" minHeight="-Infinity"/>
        </VBox>
        <VBox styleClass="panel" spacing="14" prefWidth="350" minWidth="300">
            <Label text="Next word" styleClass="section-title"/>
            <Label fx:id="suggestionsLabel" text="Suggestions appear as you type a word that has been followed before." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
            <ListView fx:id="suggestionList" minHeight="0" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
