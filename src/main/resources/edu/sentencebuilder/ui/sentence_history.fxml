<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.SentenceHistoryController" spacing="12"
      stylesheets="@app.css">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8">
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
        <Label text="Newest first. Highlighted rows were generated more than once."/>
    </HBox>
    <TableView fx:id="sentenceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="sentenceColumn" text="Sentence" prefWidth="380"/>
            <TableColumn fx:id="timesColumn" text="Times" prefWidth="60"/>
            <TableColumn fx:id="startWordColumn" text="Start word" prefWidth="100"/>
            <TableColumn fx:id="algorithmColumn" text="Algorithm" prefWidth="120"/>
            <TableColumn fx:id="createdColumn" text="Created" prefWidth="150"/>
        </columns>
    </TableView>
    <Label fx:id="statusLabel" text=" "/>
</VBox>
