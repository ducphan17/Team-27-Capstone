<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.SentenceHistoryController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Button text="Refresh" onAction="#onRefresh"/>
    <TableView fx:id="sentenceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn text="Sentence" prefWidth="400"/>
            <TableColumn text="Start word" prefWidth="100"/>
            <TableColumn text="Algorithm" prefWidth="120"/>
            <TableColumn text="Created" prefWidth="150"/>
        </columns>
    </TableView>
</VBox>
