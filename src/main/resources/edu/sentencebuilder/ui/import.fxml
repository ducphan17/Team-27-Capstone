<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.ImportController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <Label text="Import a .txt file to add its word and word-pair statistics to the database."/>
    <Button fx:id="chooseButton" text="Choose file..." onAction="#onChooseFile"/>
    <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
    <Label fx:id="statusLabel" text="No file imported yet."/>
</VBox>
