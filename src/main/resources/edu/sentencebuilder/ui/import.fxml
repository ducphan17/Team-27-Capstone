<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.ImportController" styleClass="page" spacing="20">
    <VBox spacing="5"><Label text="Import" styleClass="page-title"/>
        <Label text="Add a text file to build your word and word-pair statistics." styleClass="muted" wrapText="true" minHeight="-Infinity"/></VBox>
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox styleClass="panel,settings-panel" spacing="14" minWidth="270" prefWidth="310" maxWidth="310">
            <Label text="Source text" styleClass="section-title"/>
            <Label text="Choose a .txt file to add to your corpus." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
            <Button fx:id="chooseButton" text="Choose file…" onAction="#onChooseFile" styleClass="primary" maxWidth="Infinity"/>
            <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
            <Label fx:id="statusLabel" text="No file imported yet." wrapText="true" minHeight="-Infinity"/>
            <Label fx:id="elapsedLabel" text="Elapsed: 0:00.0" styleClass="muted"/>
        </VBox>
        <VBox styleClass="panel" spacing="14" HBox.hgrow="ALWAYS" minWidth="0">
            <Label text="Import history" styleClass="section-title"/>
            <Label text="Newest first. Corpus additions appear as batch-generated." styleClass="muted" wrapText="true" minHeight="-Infinity"/>
            <TableView fx:id="fileTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="filenameColumn" text="File" prefWidth="210"/>
                    <TableColumn fx:id="wordCountColumn" text="Words" prefWidth="80"/>
                    <TableColumn fx:id="sentenceCountColumn" text="Sentences" prefWidth="90"/>
                    <TableColumn fx:id="importedColumn" text="Imported" prefWidth="150"/>
                </columns>
            </TableView>
            <Label fx:id="historyLabel" text=" " wrapText="true" minHeight="-Infinity" styleClass="muted"/>
        </VBox>
    </HBox>
</VBox>
