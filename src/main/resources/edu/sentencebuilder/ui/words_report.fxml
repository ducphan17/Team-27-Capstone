<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.WordsReportController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8">
        <Label text="Filter:"/>
        <TextField fx:id="filterField" promptText="word contains..."/>
        <Button text="Refresh" onAction="#onRefresh"/>
    </HBox>
    <TableView fx:id="wordTable" editable="true" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="textColumn" text="Word" prefWidth="200"/>
            <TableColumn fx:id="totalColumn" text="Count" prefWidth="100"/>
            <TableColumn fx:id="startColumn" text="Start count" prefWidth="100"/>
            <TableColumn fx:id="endColumn" text="End count" prefWidth="100"/>
        </columns>
    </TableView>
</VBox>
