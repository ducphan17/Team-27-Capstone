<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.WordsReportController" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <HBox spacing="8">
        <Label text="Filter:"/>
        <TextField fx:id="filterField" promptText="word contains..."/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>
    <Label text="Click a column header to sort. Double-click a count to edit it; press Enter to save."/>
    <SplitPane orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS">
        <TableView fx:id="wordTable" editable="true" minHeight="100">
            <columns>
                <TableColumn fx:id="textColumn" text="Word" prefWidth="200"/>
                <TableColumn fx:id="totalColumn" text="Count" prefWidth="100"/>
                <TableColumn fx:id="startColumn" text="Start count" prefWidth="100"/>
                <TableColumn fx:id="endColumn" text="End count" prefWidth="100"/>
            </columns>
        </TableView>
        <VBox spacing="8" minHeight="160">
            <padding><Insets top="8" right="8" bottom="8" left="8"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="followersTitle" text="Word-pair inspector" style="-fx-font-weight: bold;"/>
                <Button fx:id="followersRefreshButton" text="Refresh followers" onAction="#onInspectFollowers" disable="true"/>
            </HBox>
            <Label text="Weight = imported + user count. Probability is for Weighted random if generation continues; sentence stopping is separate."
                   wrapText="true"/>
            <TableView fx:id="followersTable" minHeight="60" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="followerColumn" text="Next word" prefWidth="200"/>
                    <TableColumn fx:id="importedColumn" text="Imported count" prefWidth="120"/>
                    <TableColumn fx:id="userColumn" text="User count" prefWidth="100"/>
                    <TableColumn fx:id="weightColumn" text="Weight" prefWidth="100"/>
                    <TableColumn fx:id="probabilityColumn" text="Probability" prefWidth="120"/>
                </columns>
            </TableView>
            <Label fx:id="followersStatus" text="Select a word above to see what can follow it." wrapText="true"/>
        </VBox>
    </SplitPane>
    <Label fx:id="statusLabel" text=" "/>
</VBox>
