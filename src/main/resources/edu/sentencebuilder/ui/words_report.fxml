<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.sentencebuilder.ui.WordsReportController" spacing="12" styleClass="page">
    <Label text="Words Report" styleClass="page-title"/>
    <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="Filter:"/>
        <TextField fx:id="filterField" promptText="Search words…"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>
    <Label text="Click a heading to sort. Double-click a count to edit; press Enter to save." styleClass="muted"/>
    <SplitPane orientation="HORIZONTAL" dividerPositions="0.46" VBox.vgrow="ALWAYS">
        <VBox spacing="14" styleClass="panel" minWidth="350">
        <Label text="Words" styleClass="section-title"/>
        <TableView fx:id="wordTable" editable="true" minHeight="100" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn fx:id="textColumn" text="Word" prefWidth="155" minWidth="80"/>
                <TableColumn fx:id="totalColumn" text="Count" prefWidth="80" minWidth="60"/>
                <TableColumn fx:id="startColumn" text="Start count" prefWidth="95" minWidth="80"/>
                <TableColumn fx:id="endColumn" text="End count" prefWidth="95" minWidth="80"/>
            </columns>
        </TableView>
        </VBox>
        <VBox spacing="14" styleClass="panel" minWidth="500">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="followersTitle" text="Word-pair inspector" styleClass="section-title" HBox.hgrow="ALWAYS" minWidth="0" maxWidth="Infinity" wrapText="true" minHeight="-Infinity"/>
                <Button fx:id="followersRefreshButton" text="Refresh followers" onAction="#onInspectFollowers" disable="true"/>
            </HBox>
            <Label text="Weight = imported + user count. Probability is for Weighted random if generation continues; sentence stopping is separate."
                   wrapText="true" minHeight="-Infinity"/>
            <TableView fx:id="followersTable" minHeight="60" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="followerColumn" text="Next word" prefWidth="140" minWidth="90"/>
                    <TableColumn fx:id="importedColumn" text="Imported count" prefWidth="110" minWidth="100"/>
                    <TableColumn fx:id="userColumn" text="User count" prefWidth="95" minWidth="85"/>
                    <TableColumn fx:id="weightColumn" text="Weight" prefWidth="95" minWidth="85"/>
                    <TableColumn fx:id="probabilityColumn" text="Probability" prefWidth="100" minWidth="90"/>
                </columns>
            </TableView>
            <Label fx:id="followersStatus" text="Select a word to see what can follow it." wrapText="true" minHeight="-Infinity"/>
        </VBox>
    </SplitPane>
    <Label fx:id="statusLabel" text=" "/>
</VBox>
