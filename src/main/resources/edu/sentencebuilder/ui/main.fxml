<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="workspace" fx:controller="edu.sentencebuilder.ui.MainController" stylesheets="@app.css">
    <HBox styleClass="app-header" alignment="CENTER_LEFT">
        <Label text="SentenceBuilder" styleClass="app-brand"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ToggleButton fx:id="darkModeToggle" text="Dark mode" onAction="#onToggleDarkMode" accessibleText="Switch to dark mode"/>
    </HBox>
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="importTab" text="Import"><fx:include fx:id="fileImport" source="import.fxml"/></Tab>
        <Tab text="Generate"><fx:include source="generate.fxml"/></Tab>
        <Tab text="Batch Generate"><fx:include source="batch_generate.fxml"/></Tab>
        <Tab text="Autocomplete"><fx:include source="autocomplete.fxml"/></Tab>
        <Tab fx:id="wordsReportTab" text="Words Report"><fx:include fx:id="wordsReport" source="words_report.fxml"/></Tab>
        <Tab fx:id="sentenceHistoryTab" text="Sentence History"><fx:include fx:id="sentenceHistory" source="sentence_history.fxml"/></Tab>
    </TabPane>
</VBox>
