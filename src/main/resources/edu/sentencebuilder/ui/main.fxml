<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>

<!-- Each tab's view and controller live in their own FXML file.
     MainController reloads the import history and report tabs when they are selected. -->
<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="edu.sentencebuilder.ui.MainController"
         tabClosingPolicy="UNAVAILABLE">
    <Tab fx:id="importTab" text="Import">
        <fx:include fx:id="fileImport" source="import.fxml"/>
    </Tab>
    <Tab text="Generate">
        <fx:include source="generate.fxml"/>
    </Tab>
    <Tab text="Batch Generate">
        <fx:include source="batch_generate.fxml"/>
    </Tab>
    <Tab text="Autocomplete">
        <fx:include source="autocomplete.fxml"/>
    </Tab>
    <Tab fx:id="wordsReportTab" text="Words Report">
        <fx:include fx:id="wordsReport" source="words_report.fxml"/>
    </Tab>
    <Tab fx:id="sentenceHistoryTab" text="Sentence History">
        <fx:include fx:id="sentenceHistory" source="sentence_history.fxml"/>
    </Tab>
</TabPane>
